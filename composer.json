{
    "name": "s-fx/blt-events",
    "description": "Event registration for WordPress: calendars, tickets, configurable forms, waitlists, reminders and payment integrations.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/S-FX-com/BLT-Events",
    "authors": [
        {
            "name": "S-FX.com",
            "homepage": "https://www.s-fx.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/wordpress-stubs": "^6.6",
        "sirbrillig/phpcs-variable-analysis": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "for f in $(git ls-files '*.php' | grep -v '^includes/lib/'); do php -l \"$f\" > /dev/null || exit 1; done",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test": "phpunit",
        "check": [
            "@lint",
            "@phpcs",
            "@test"
        ]
    }
}
